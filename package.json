{
  "name": "mel-one-local-website",
  "version": "1.0.0",
  "description": "MEL ONE — Adelaide household-maintenance website candidate",
  "private": true,
  "dependencies": {
    "cheerio": "1.0.0",
    "parse5": "8.0.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "domhandler": "5.0.3",
    "typescript": "5.9.3"
  },
  "scripts": {
    "editor:dev": "node tools/editor/launch-local.cjs --no-open",
    "editor:typecheck": "tsc --project tsconfig.editor.json",
    "editor:test": "node --test --test-concurrency=1 tests/local-editor*.test.mjs",
    "editor:changes": "node tools/editor/export-changes.mts",
    "build": "node build.mjs",
    "build:docs": "node build.mjs --docs",
    "i18n:extract": "node build.mjs --i18n-extract",
    "check:bilingual": "node --test test/bilingual*.test.mjs",
    "serve": "node serve.cjs",
    "start": "node serve.cjs",
    "check": "node tests/stage3-current-check.cjs",
    "check:layout": "node build.mjs && node --test scripts/check-content-layout.cjs",
    "test": "node build.mjs && node --test --test-concurrency=1 test/*.test.cjs test/*.test.mjs tests/*.test.cjs"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
